<view class="choice-group">
  <view
    wx:for="{{options}}"
    wx:key="value"
    class="choice-tile {{selectedMap[item.value] ? 'choice-tile--selected' : ''}} {{disabled ? 'choice-tile--disabled' : ''}}"
    data-value="{{item.value}}"
    bindtap="change"
  >
    <view class="choice-title">{{item.label}}</view>
    <view wx:if="{{item.caption}}" class="choice-caption">{{item.caption}}</view>
  </view>
</view>
