page {
  background: var(--cdms-background);
}

.followup-detail-page {
  padding-bottom: 112rpx;
}

.detail-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.loading-panel {
  margin-top: 24rpx;
}

.choice-block {
  margin-bottom: 18rpx;
}

.choice-title {
  margin-bottom: 10rpx;
  color: var(--cdms-text);
  font-size: 25rpx;
  font-weight: 700;
}

.cat-item {
  margin-bottom: 24rpx;
}

.cat-label {
  margin-bottom: 10rpx;
  color: var(--cdms-text);
  font-size: 24rpx;
  line-height: 34rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #f6faf8;
  color: var(--cdms-text);
  font-size: 25rpx;
}

.form-textarea {
  min-height: 150rpx;
}

.empty-inline {
  padding: 10rpx 0;
  color: var(--cdms-muted);
  font-size: 22rpx;
}

.photo-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(13, 82, 57, 0.08);
}

.photo-row:last-child {
  border-bottom: 0;
}

.photo-copy {
  min-width: 0;
}

.photo-name {
  color: var(--cdms-text);
  font-size: 24rpx;
  font-weight: 700;
}

.photo-url {
  margin-top: 6rpx;
  color: var(--cdms-muted);
  font-size: 21rpx;
  line-height: 30rpx;
  word-break: break-all;
}

.photo-remove,
.photo-add {
  flex: none;
}

.photo-add {
  margin-top: 16rpx;
}
