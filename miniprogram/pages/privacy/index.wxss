.page { display: flex; flex-direction: column; height: 100vh; background: #fff; }
.content { flex: 1; height: 0; padding: 24px 20px 0; box-sizing: border-box; }
.para { font-size: 15px; line-height: 1.75; color: #294238; margin-bottom: 12px; word-break: break-word; }
.para-title { font-size: 18px; font-weight: 700; color: #183b2c; margin-bottom: 18px; }
.bottom-space { height: 16px; }
.content-inner { display: block; }
.footer { padding: 12px 20px 18px; border-top: 1px solid #e2ece6; background: #fff; }
.primary { color: #fff; background: #3f9870; border-radius: 8px; font-size: 15px; }
.primary[disabled] { color: #fff; background: #b7cdc2; }
.withdraw { margin-top: 10px; text-align: center; color: #8a948f; font-size: 13px; }
