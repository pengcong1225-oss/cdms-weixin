<view class="page">
  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="onReachBottom" lower-threshold="20">
    <view class="content-inner">
      <view wx:for="{{paragraphs}}" wx:key="index" class="para {{index === 0 ? 'para-title' : ''}}">{{item}}</view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>
  <view class="footer">
    <button class="primary" disabled="{{!reachedBottom}}" bindtap="agree">{{reachedBottom ? '我已阅读并同意' : '请滑动阅读至底部'}}</button>
  </view>
</view>
