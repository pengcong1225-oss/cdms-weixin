<view class="page">
  <view class="brand">CDMS 慢阻肺管理</view>
  <view class="subtitle">微信授权登录</view>
  <input class="input" type="number" maxlength="11" placeholder="请输入已建档手机号" value="{{phone}}" bindinput="onPhone" />
  <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="login">微信授权登录</button>
  <view wx:if="{{roleSelectionRequired}}" class="roles">
    <view class="role-title">请选择进入身份</view>
    <button wx:for="{{roles}}" wx:key="roleType" data-role="{{item.roleType}}" bindtap="selectRole">{{item.displayName}}（{{item.roleType === 'DOCTOR' ? '医生' : '患者'}}）</button>
  </view>
  <view class="hint">微信登录不会保存密码。手机号用于匹配 CDMS 中的患者档案，微信授权凭证只在服务端兑换。</view>
</view>
