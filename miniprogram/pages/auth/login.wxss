.page { min-height: 100vh; padding: 104rpx 44rpx 64rpx; box-sizing: border-box; background: linear-gradient(180deg, #eaf7f1 0, #f6faf8 52%, #f4f7f5 100%); }
.brand-block { text-align: center; margin-bottom: 52rpx; }
.brand-mark { width: 82rpx; height: 82rpx; line-height: 82rpx; margin: 0 auto 22rpx; border-radius: 26rpx; color: #fff; background: #3f9870; font-size: 26rpx; font-weight: 700; box-shadow: 0 12rpx 28rpx rgba(63, 152, 112, .18); }
.brand { color: #183b2c; font-size: 43rpx; font-weight: 700; letter-spacing: 2rpx; }
.subtitle { color: #71877c; font-size: 25rpx; margin-top: 14rpx; }
.login-card { background: #fff; border-radius: 28rpx; padding: 30rpx 30rpx 34rpx; box-shadow: 0 16rpx 44rpx rgba(41, 92, 67, .1); }
.mode-tabs { display: flex; padding: 6rpx; margin-bottom: 38rpx; border-radius: 16rpx; background: #f0f6f2; }
.mode-tab { flex: 1; padding: 18rpx 0; border-radius: 12rpx; color: #71877c; text-align: center; font-size: 28rpx; }
.mode-tab.active { color: #267b56; background: #fff; box-shadow: 0 4rpx 12rpx rgba(48, 112, 80, .08); font-weight: 700; }
.field-label { color: #294238; font-size: 25rpx; margin: 20rpx 4rpx 12rpx; }
.input { width: 100%; height: 88rpx; background: #f7faf8; border: 1rpx solid #e2ece6; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 18rpx; box-sizing: border-box; }
.primary { color: #fff; background: #3f9870; border-radius: 16rpx; margin-top: 26rpx; font-size: 29rpx; }
.form-hint { color: #8a9c92; font-size: 22rpx; line-height: 1.6; margin-top: 22rpx; }
.roles { margin-top: 30rpx; background: #fff; border-radius: 22rpx; padding: 24rpx; box-shadow: 0 10rpx 30rpx rgba(41, 92, 67, .08); }
.role-title { color: #27332d; font-size: 30rpx; margin-bottom: 18rpx; }
.roles button { margin: 14rpx 0; color: #267b56; background: #eff8f2; }
.hint { color: #8a948f; font-size: 23rpx; margin-top: 36rpx; line-height: 1.6; text-align: center; }
