<view class="page home-page">
  <view class="topbar">
    <view class="greeting">
      <view class="eyebrow">COPD 健康管理</view>
      <view class="hero-title">今天感觉怎么样？</view>
      <view class="hero-subtitle">连接设备，查看你的健康趋势</view>
    </view>
    <view class="profile-actions">
      <view class="profile-mark">RW</view>
      <view class="logout-button" bindtap="logout">退出登录</view>
    </view>
  </view>

  <view wx:if="{{activeRole}}" class="role-pill" bindtap="switchRole">
    <view class="role-dot"></view>
    <text>当前身份：{{activeRole === 'DOCTOR' ? '医生' : '患者'}}</text>
    <text class="role-switch">切换身份 ›</text>
  </view>

  <view wx:if="{{workspaceEntries.length}}" class="workspace-section">
    <view class="section-heading workspace-heading">
      <view>
        <view class="section-title">业务入口</view>
        <view class="section-caption">患者档案、随访与设备中心</view>
      </view>
    </view>
    <view
      wx:for="{{workspaceEntries}}"
      wx:key="key"
      class="workspace-card"
      data-key="{{item.key}}"
      bindtap="openWorkspaceEntry"
    >
      <view class="workspace-icon">{{item.key === 'device' ? '设' : item.key === 'patients' ? '患' : '随'}}</view>
      <view class="workspace-copy">
        <view class="workspace-title">{{item.title}}</view>
        <view class="workspace-subtitle">{{item.subtitle}}</view>
      </view>
      <text class="workspace-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{boundDevice}}" class="device-section">
    <view class="section-heading">
      <view>
        <view class="section-title">我的设备</view>
        <view class="section-caption">{{lastSyncText}}</view>
      </view>
      <view class="connection-badge {{connected ? 'online' : 'offline'}}">
        <view class="connection-dot"></view>{{connected ? '已连接' : '未连接'}}
      </view>
    </view>
    <device-card
      device="{{boundDevice}}"
      connectionState="{{connectionState}}"
      bindselect="openDevice"
    />
  </view>

  <view wx:else class="unbound-card" bindtap="openSearch">
    <view class="unbound-icon">+</view>
    <view class="unbound-content">
      <view class="unbound-title">连接你的 RW 智能戒指</view>
      <view class="unbound-subtitle">绑定设备后，自动同步健康数据</view>
    </view>
    <text class="unbound-arrow">›</text>
  </view>

  <view wx:if="{{healthSyncing}}" class="sync-progress-wrap">
    <view class="sync-progress-label">正在同步健康数据 {{healthSyncProgress}}%</view>
    <view class="sync-progress">
      <view class="sync-progress-bar" style="width: {{healthSyncProgress}}%"></view>
    </view>
  </view>

  <view class="section-heading health-heading">
    <view>
      <view class="section-title">健康数据</view>
      <view class="section-caption">{{boundDevice ? '设备最近同步数据' : '绑定设备后显示'}}</view>
    </view>
    <view wx:if="{{boundDevice}}" class="refresh-hint">下拉同步</view>
  </view>

  <view wx:if="{{healthCards.length}}" class="health-grid">
    <view
      wx:for="{{healthCards}}"
      wx:key="type"
      class="health-card"
      data-type="{{item.type}}"
      bindtap="openHistory"
    >
      <view class="health-top">
        <view class="health-icon">{{item.icon}}</view>
        <text class="health-arrow">›</text>
      </view>
      <view class="health-title">{{item.title}}</view>
      <view class="health-value">{{item.valueText}}</view>
      <view class="health-time">{{item.timeText}}</view>
    </view>
  </view>

  <view wx:else class="empty-card">
    <view class="empty-illustration">⌁</view>
    <view class="empty-title">暂无健康数据</view>
    <view class="empty-text">{{boundDevice ? '重新连接设备后下拉页面同步' : '先绑定设备，开始记录健康趋势'}}</view>
    <button wx:if="{{!boundDevice}}" class="primary-button" bindtap="openSearch">添加设备</button>
  </view>

  <view wx:if="{{cdmsQueue || cdmsStatus}}" class="sync-card">
    <view class="sync-card-icon">↥</view>
    <view class="sync-card-copy">
      <view class="sync-card-title">CDMS 数据同步</view>
      <view class="sync-card-text">{{cdmsStatus || '数据已进入上传队列'}}</view>
      <view wx:if="{{cdmsQueue}}" class="sync-card-queue">待上传批次：{{cdmsQueue}}</view>
    </view>
  </view>
</view>
