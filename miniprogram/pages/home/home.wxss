page {
  background: var(--cdms-background);
}

.home-page {
  min-height: 100vh;
  padding: 0 28rpx 48rpx;
  box-sizing: border-box;
  color: var(--cdms-text);
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 42rpx 4rpx 28rpx;
}

.greeting {
  min-width: 0;
}

.profile-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
  margin-left: 16rpx;
}

.eyebrow {
  color: var(--cdms-primary);
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 9rpx;
  color: var(--cdms-text);
  font-size: 42rpx;
  line-height: 58rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  margin-top: 6rpx;
  color: var(--cdms-muted);
  font-size: 24rpx;
}

.profile-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  flex: none;
  margin-top: 4rpx;
  border: 8rpx solid var(--cdms-primary-soft);
  border-radius: 50%;
  background: var(--cdms-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 750;
  box-shadow: 0 10rpx 24rpx rgba(12, 155, 108, .2);
}

.logout-button {
  margin-top: 10rpx;
  color: var(--cdms-muted);
  font-size: 21rpx;
  line-height: 30rpx;
}

.role-pill {
  display: flex;
  align-items: center;
  min-height: 62rpx;
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--cdms-border);
  border-radius: 999rpx;
  background: var(--cdms-primary-soft);
  color: var(--cdms-primary);
  font-size: 23rpx;
}

.role-dot,
.connection-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--cdms-primary);
  box-shadow: 0 0 0 5rpx rgba(17, 163, 111, .12);
}

.role-switch {
  margin-left: auto;
  color: var(--cdms-muted);
  font-size: 21rpx;
}

.workspace-card,
.unbound-card,
.empty-card,
.sync-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid var(--cdms-border);
  border-radius: var(--cdms-radius-card);
  background: var(--cdms-surface);
  box-shadow: var(--cdms-shadow-card);
}

.workspace-card {
  min-height: 124rpx;
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
}

.workspace-section {
  margin-bottom: 22rpx;
}

.workspace-heading {
  margin-top: 0;
}

.workspace-icon,
.sync-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--cdms-primary-soft, #e5f6ee);
  color: var(--cdms-primary, #0c9568);
  font-size: 26rpx;
  font-weight: 700;
}

.workspace-copy,
.sync-card-copy {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.workspace-title,
.sync-card-title {
  color: var(--cdms-text, #23463a);
  font-size: 29rpx;
  font-weight: 700;
}

.workspace-subtitle,
.sync-card-text {
  margin-top: 7rpx;
  color: var(--cdms-muted, #8a9a93);
  font-size: 22rpx;
}

.workspace-arrow,
.unbound-arrow {
  margin-left: 16rpx;
  color: var(--cdms-chevron);
  font-size: 42rpx;
  font-weight: 200;
}

.device-section {
  margin-bottom: 28rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 4rpx 16rpx;
}

.section-title {
  color: var(--cdms-heading);
  font-size: 29rpx;
  line-height: 42rpx;
  font-weight: 720;
}

.section-caption {
  margin-top: 3rpx;
  color: var(--cdms-caption);
  font-size: 21rpx;
}

.connection-badge {
  display: flex;
  align-items: center;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.connection-badge .connection-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 9rpx;
  box-shadow: none;
}

.connection-badge.online {
  background: var(--cdms-primary-soft);
  color: var(--cdms-primary);
}

.connection-badge.offline {
  background: var(--cdms-status-neutral-soft);
  color: var(--cdms-status-neutral);
}

.connection-badge.offline .connection-dot {
  background: var(--cdms-status-neutral);
}

.unbound-card {
  min-height: 150rpx;
  margin-bottom: 30rpx;
  padding: 28rpx;
  border: 2rpx dashed var(--cdms-border);
  background: rgba(255, 255, 255, .78);
}

.unbound-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 50%;
  background: var(--cdms-primary-soft);
  color: var(--cdms-primary);
  font-size: 45rpx;
  font-weight: 300;
}

.unbound-content {
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
}

.unbound-title {
  overflow: hidden;
  color: var(--cdms-heading);
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unbound-subtitle {
  margin-top: 9rpx;
  color: var(--cdms-muted);
  font-size: 22rpx;
}

.sync-progress-wrap {
  margin: -10rpx 4rpx 26rpx;
}

.sync-progress-label,
.refresh-hint {
  color: var(--cdms-primary);
  font-size: 21rpx;
}

.sync-progress {
  overflow: hidden;
  height: 8rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: var(--cdms-primary-soft);
}

.sync-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0c9b6c, #67cba6);
  transition: width 180ms ease;
}

.health-heading {
  margin-top: 8rpx;
}

.health-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.health-card {
  min-height: 220rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--cdms-border);
  border-radius: var(--cdms-radius-card);
  background: var(--cdms-surface);
  box-shadow: var(--cdms-shadow-card);
}

.health-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.health-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 19rpx;
  background: var(--cdms-primary-soft);
  color: var(--cdms-primary);
  font-size: 23rpx;
  font-weight: 700;
}

.health-arrow {
  color: var(--cdms-chevron);
  font-size: 35rpx;
  font-weight: 200;
}

.health-title {
  margin-top: 18rpx;
  color: var(--cdms-muted);
  font-size: 23rpx;
}

.health-value {
  overflow: hidden;
  margin-top: 7rpx;
  color: var(--cdms-text);
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-time {
  margin-top: 7rpx;
  color: var(--cdms-caption);
  font-size: 20rpx;
}

.empty-card {
  flex-direction: column;
  justify-content: center;
  min-height: 260rpx;
  margin-top: 2rpx;
  padding: 34rpx;
  text-align: center;
}

.empty-illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: var(--cdms-primary-soft);
  color: var(--cdms-primary);
  font-size: 42rpx;
}

.empty-title {
  margin-top: 17rpx;
  color: var(--cdms-heading);
  font-size: 27rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 7rpx;
  color: var(--cdms-caption);
  font-size: 22rpx;
}

.primary-button {
  min-width: 190rpx;
  height: 70rpx;
  margin: 22rpx 0 0;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: var(--cdms-primary);
  color: #fff;
  font-size: 25rpx;
  line-height: 70rpx;
  box-shadow: 0 10rpx 22rpx rgba(12, 155, 108, .18);
}

.sync-card {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
}

.sync-card-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
}

.sync-card-queue {
  margin-top: 7rpx;
  color: #b27b2f;
  font-size: 21rpx;
}
