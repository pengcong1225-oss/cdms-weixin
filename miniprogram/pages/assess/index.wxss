.assess-page { padding-bottom: 40rpx; }
.assess-heading { padding: 36rpx 4rpx 22rpx; }
.assess-heading-title { color: #29453b; font-size: 42rpx; line-height: 56rpx; font-weight: 750; }
.assess-heading-sub { margin-top: 8rpx; color: #91a099; font-size: 23rpx; }
.assess-card { display: flex; align-items: center; margin-bottom: 20rpx; padding: 26rpx 24rpx; }
.assess-icon {
  display: flex; align-items: center; justify-content: center;
  width: 84rpx; height: 84rpx; flex: none; border-radius: 24rpx;
  background: #e5f6ee; color: #0c9b6c; font-size: 26rpx; font-weight: 800;
}
.assess-copy { min-width: 0; flex: 1; margin-left: 20rpx; }
.assess-title { color: #29483d; font-size: 29rpx; font-weight: 700; }
.assess-text { margin-top: 7rpx; color: #6f8178; font-size: 22rpx; line-height: 1.55; }
.assess-hint { margin-top: 6rpx; color: #b7791f; font-size: 21rpx; }
.assess-note { margin: 30rpx 8rpx 0; color: #91a099; font-size: 21rpx; line-height: 1.6; }
