<view class="page assess-history-page">
  <view class="section-title">自测历史<text class="section-caption">共 {{list.length}} 条</text></view>
  <view wx:if="{{list.length}}" class="card history-list">
    <view
      wx:for="{{list}}"
      wx:key="createdAt"
      class="history-cell"
      data-index="{{index}}"
      bindtap="openDetail"
    >
      <view class="history-type">{{item.title}}</view>
      <view class="history-main">
        <view class="history-summary">{{item.summary}}</view>
        <view class="history-time">{{item.timeText}}</view>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>
  <view wx:else class="card empty-card">
    <view class="empty-illustration">测</view>
    <view class="empty-title">暂无自测记录</view>
    <view class="empty-text">完成 CAT 问卷或 mMRC 分级后，结果会保存在这里</view>
  </view>
  <button wx:if="{{list.length}}" class="clear-button" bindtap="clearHistory">清空自测历史</button>
</view>
