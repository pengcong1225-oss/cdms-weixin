.page-heading {
  padding: 10rpx 4rpx 30rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #87928d;
  font-size: 24rpx;
}

/* Task A：绑定归属其他账号（异设备）提示 */
.foreign-notice {
  margin-bottom: 22rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #e8d3a4;
  border-radius: 22rpx;
  background: #fffbf1;
}

.foreign-notice-title {
  color: #8a6419;
  font-size: 28rpx;
  font-weight: 650;
}

.foreign-notice-text {
  margin-top: 8rpx;
  color: #a08a5e;
  font-size: 23rpx;
  line-height: 34rpx;
}

.unbound-device {
  display: flex;
  align-items: center;
  min-height: 142rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border: 2rpx dashed #bdc9c3;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.72);
}

.unbound-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e2f3ec;
  color: #0c9b6c;
  font-size: 42rpx;
  font-weight: 300;
}

.unbound-main {
  flex: 1;
  margin-left: 24rpx;
}

.unbound-title {
  font-size: 30rpx;
  font-weight: 620;
}

.unbound-text {
  margin-top: 7rpx;
  color: #8e9893;
  font-size: 23rpx;
}

.connection-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.connection-actions button {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
}

.connect-button {
  background: #0c9b6c;
  color: #fff;
}

.outline-button {
  background: #e4f2ec;
  color: #087e59;
}

.danger-button {
  background: #fff0f0;
  color: #c64b4b;
}

.setting-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  margin-right: 20rpx;
  border-radius: 17rpx;
  background: #edf6f2;
  color: #168662;
  font-size: 23rpx;
  font-weight: 650;
}

.support-value {
  color: #0c9568;
}

.device-empty {
  margin-top: 34rpx;
}

.feature-empty {
  padding-top: 48rpx;
  padding-bottom: 48rpx;
}
/* 医生端设备目录 */
.iot-device-list {
  margin-top: 4rpx;
}

.iot-device-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--cdms-border);
  border-radius: var(--cdms-radius-card);
  background: var(--cdms-surface);
  box-shadow: var(--cdms-shadow-card);
}

.iot-device-card.disabled {
  opacity: .58;
}

.iot-device-top {
  display: flex;
  align-items: center;
}

.iot-device-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--cdms-primary-soft);
  color: var(--cdms-primary);
  font-size: 25rpx;
  font-weight: 700;
}

.iot-device-copy {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.iot-device-title {
  color: var(--cdms-text);
  font-size: 29rpx;
  font-weight: 700;
}

.iot-device-category,
.iot-device-subtitle,
.iot-device-note {
  color: var(--cdms-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

.iot-device-category {
  margin-top: 5rpx;
}

.iot-device-status {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--cdms-primary-soft);
  color: var(--cdms-primary);
  font-size: 21rpx;
  white-space: nowrap;
}

.iot-device-protocol {
  margin-top: 20rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: var(--cdms-background);
  color: var(--cdms-text-secondary);
  font-size: 22rpx;
}

.iot-device-subtitle {
  margin-top: 14rpx;
}

.iot-device-action {
  margin-top: 18rpx;
  color: var(--cdms-primary);
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
}

.iot-device-action text {
  margin-left: 6rpx;
  font-size: 32rpx;
  font-weight: 300;
  vertical-align: -2rpx;
}

.iot-device-note {
  margin: 4rpx 8rpx 24rpx;
  text-align: center;
}

/* 采集间隔 / 预警值弹层 */
.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.dialog {
  width: 640rpx;
  padding: 36rpx 32rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.dialog-title {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2d27;
}

.dialog-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border: 1rpx solid #dfece6;
  border-radius: 16rpx;
  background: #f7fbf9;
  color: #1f2d27;
  font-size: 28rpx;
}

.dialog-picker-arrow {
  color: #0d9167;
}

.dialog-hint {
  margin-top: 16rpx;
  color: #6b7c74;
  font-size: 24rpx;
}

.dialog-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dialog-label {
  width: 90rpx;
  color: #1f2d27;
  font-size: 28rpx;
}

.dialog-input {
  flex: 1;
  padding: 16rpx 20rpx;
  border: 1rpx solid #dfece6;
  border-radius: 14rpx;
  background: #f7fbf9;
  font-size: 28rpx;
}

.dialog-input.disabled {
  background: #f1f3f2;
  color: #9aa5a0;
}

.dialog-unit {
  width: 70rpx;
  padding-left: 16rpx;
  color: #6b7c74;
  font-size: 26rpx;
}

.dialog-error {
  margin-bottom: 16rpx;
  color: #d84b4b;
  font-size: 24rpx;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.dialog-btn {
  margin-left: 20rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #eef3f0;
  color: #1f2d27;
  font-size: 28rpx;
}

.dialog-btn.primary {
  background: #0c9b6c;
  color: #fff;
}

