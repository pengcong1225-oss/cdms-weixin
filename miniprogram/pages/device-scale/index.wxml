<view class="page">
  <view class="hero"><view class="back" bindtap="goBack">‹</view><view><view class="eyebrow">医生工作台</view><view class="title">身高体脂秤</view></view><view class="badge">待实机验收</view></view>
  <view class="notice">花潮 AiLink 独立蓝牙通道，指环功能不受影响</view>
  <view class="card"><view class="section-title">1. 选择患者（仅当前机构确诊患者）</view>
<view class="search-row"><input class="search-input" placeholder="搜索姓名 / 身份证 / 手机号" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="searchPatients"/><button class="search-btn" size="mini" loading="{{searching}}" bindtap="searchPatients">搜索</button></view>
<picker mode="selector" range="{{patientNames}}" value="{{patientIndex}}" bindchange="selectPatient"><view class="picker">{{selectedPatient ? selectedPatient.name : '请选择患者（共 ' + patientNames.length + ' 人）'}} <text>⌄</text></view></picker>
<view wx:if="{{patientHasMore}}" class="loadmore" bindtap="loadMorePatients">{{searching ? '加载中…' : '加载更多患者'}}</view>
<view wx:if="{{patientProfile}}" class="profile-card"><view class="profile-title">已选患者档案（请核对，防重名）</view><view class="profile-grid"><text>姓名：{{patientProfile.name}}</text><text>性别：{{patientProfile.genderText || '—'}}</text><text>年龄：{{patientProfile.age || '—'}}</text><text>手机：{{patientProfile.phone || '—'}}</text><text>身份证：{{patientProfile.idCard || '—'}}</text></view></view>
<view class="profile-fields"><input placeholder="性别 0女 / 1男" value="{{gender}}" bindinput="onGender"/><input type="number" placeholder="年龄" value="{{age}}" bindinput="onAge"/><input type="number" placeholder="身高 cm" value="{{height}}" bindinput="onHeight"/></view></view>
  <view class="card"><view class="section-title">2. 连接体脂秤</view><button class="outline" loading="{{scanning}}" bindtap="scan">扫描 AiLink 体脂秤</button><picker mode="selector" range="{{deviceNames}}" value="{{deviceIndex}}" bindchange="onDeviceChange"><view class="picker">{{deviceNames[deviceIndex] || '未选择设备'}} <text>⌄</text></view></picker><button class="primary" loading="{{connecting}}" bindtap="connect">{{connected ? '已连接' : '连接设备'}}</button><view class="status">{{statusText}}</view></view>
  <view class="card"><view class="section-title">3. 测量与确认</view><button class="primary" disabled="{{!connected || !selectedPatient}}" loading="{{measuring}}" bindtap="startMeasure">开始测量</button><view wx:if="{{metrics.length}}" class="metrics"><view wx:for="{{metrics}}" wx:key="name" class="metric"><text>{{item.label}}</text><text class="metric-value">{{item.value}} {{item.unit}}</text></view></view><button wx:if="{{canConfirm}}" class="confirm" bindtap="confirmSave">确认并绑定</button></view>
  <view wx:if="{{errorText}}" class="error">{{errorText}}</view>
</view>