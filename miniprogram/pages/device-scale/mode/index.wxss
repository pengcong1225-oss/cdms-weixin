.mode-page { padding-bottom: 40rpx; }
.mode-stack { display: grid; gap: 24rpx; }
.mode-intro { padding: 30rpx; }
.eyebrow { color: #0c9b6c; font-size: 24rpx; font-weight: 700; }
.mode-title { color: #14352b; font-size: 42rpx; font-weight: 800; margin-top: 10rpx; }
.mode-text { color: #718078; font-size: 26rpx; line-height: 1.65; margin-top: 12rpx; }
.mode-card { display: flex; align-items: center; gap: 22rpx; padding: 28rpx; }
.mode-icon { width: 84rpx; height: 84rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 800; flex-shrink: 0; }
.primary-icon { color: #087553; background: #dff7ed; }
.secondary-icon { color: #6c5a19; background: #fff4c9; }
.mode-copy { min-width: 0; flex: 1; }
.mode-name { color: #14352b; font-size: 32rpx; font-weight: 800; }
.mode-desc { color: #718078; font-size: 25rpx; line-height: 1.55; margin-top: 8rpx; }
.mode-badge { display: inline-block; margin-top: 14rpx; color: #087553; background: #eefaf5; border-radius: 999rpx; padding: 6rpx 14rpx; font-size: 22rpx; }
.neutral-badge { color: #79661d; background: #fff9e2; }
