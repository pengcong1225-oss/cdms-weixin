.page{min-height:100vh;background:#f4f8f6;padding-bottom:32rpx;color:#173d32}.hero{padding:36rpx 32rpx 28rpx;background:linear-gradient(135deg,#31966e,#17644c);color:#fff;display:flex;align-items:center;gap:20rpx}.back{font-size:58rpx;line-height:1}.eyebrow{font-size:24rpx;opacity:.8}.title{font-size:42rpx;font-weight:700}.badge{margin-left:auto;background:rgba(255,255,255,.18);border-radius:24rpx;padding:10rpx 16rpx;font-size:22rpx}.notice{margin:20rpx 24rpx;color:#6f867d;font-size:24rpx}.card{margin:20rpx 24rpx;background:#fff;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 26rpx rgba(23,61,50,.06)}.section-title{font-weight:700;font-size:30rpx;margin-bottom:20rpx}.picker{border:1rpx solid #dce8e2;border-radius:14rpx;padding:24rpx;color:#527166;display:flex;justify-content:space-between}.profile-fields{display:flex;gap:12rpx;margin-top:16rpx}.profile-fields input{min-width:0;flex:1;border:1rpx solid #dce8e2;border-radius:12rpx;padding:18rpx 12rpx;font-size:24rpx}.outline,.primary,.confirm{margin-top:18rpx;border-radius:14rpx;font-size:28rpx}.outline{color:#16805b;background:#eff9f4;border:1rpx solid #a9ddc4}.primary,.confirm{color:#fff;background:#31966e}.confirm{background:#d88a35}.status{margin-top:16rpx;text-align:center;color:#6f867d;font-size:24rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.metric{background:#f3faf6;border-radius:14rpx;padding:18rpx;font-size:24rpx}.metric-value{display:block;font-size:30rpx;font-weight:700;margin-top:8rpx}.error{margin:24rpx;color:#c65353;background:#fff0f0;border-radius:14rpx;padding:20rpx;font-size:24rpx}
