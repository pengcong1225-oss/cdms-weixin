<view class="page station-page">
  <app-header
    title="体脂秤工作站"
    subtitle="场次令牌只用于扫码签到，患者身份由服务端派生"
    showBack="{{true}}"
    bindback="backWorkspace"
  />

  <state-panel wx:if="{{errorText}}" state="error" title="操作失败" message="{{errorText}}" actionText="重试" bindaction="retry" />

  <view wx:elif="{{loading}}" class="loading-panel">
    <state-panel state="loading" title="加载中" message="正在读取体脂秤场次" />
  </view>

  <view wx:else class="station-stack">
    <form-section title="场次" caption="二维码仅包含不透明签到令牌">
      <view class="station-summary">
        <view class="station-main">
          <view class="station-title">场次 {{stationId || '未创建'}}</view>
          <view class="station-meta">状态：{{stationStatus}}</view>
          <view class="station-meta">令牌：{{checkinToken || '等待创建'}}</view>
          <view wx:if="{{tokenExpiresAt}}" class="station-meta">过期：{{tokenExpiresAt}}</view>
        </view>
        <view class="station-side">
          <button class="secondary-button" bindtap="copyToken" wx:if="{{checkinToken}}">复制令牌</button>
          <button class="primary-button" loading="{{creating}}" bindtap="createStation">创建场次</button>
        </view>
      </view>
      <view class="station-actions">
        <button class="secondary-button" bindtap="callNext">下一位</button>
        <button class="secondary-button" bindtap="skipCurrent">跳过</button>
        <button class="secondary-button" bindtap="requeueCurrent">重排</button>
        <button class="secondary-button" loading="{{saving}}" bindtap="confirmMeasurement">确认并提交</button>
        <button class="secondary-button" bindtap="closeStation">关闭场次</button>
      </view>
    </form-section>

    <form-section title="当前患者" caption="仅展示服务端脱敏摘要和测量参数">
      <view wx:if="{{currentQueueItem}}" class="patient-card">
        <view class="patient-name">{{currentQueueItem.patientSummary.maskedName}}</view>
        <view class="patient-meta">状态：{{currentQueueItem.status}}</view>
        <view class="patient-meta">性别：{{currentQueueItem.patientSummary.genderText || currentQueueItem.patientSummary.gender}}</view>
        <view class="patient-meta">年龄：{{currentQueueItem.patientSummary.age}}</view>
        <view class="patient-meta">身高：{{currentQueueItem.patientSummary.heightText || currentQueueItem.patientSummary.height}}</view>
        <view wx:if="{{currentDraft}}" class="patient-meta">草稿：{{currentDraft.id}} / {{currentDraft.status}}</view>
      </view>
      <view wx:else class="empty-inline">暂无当前患者</view>
    </form-section>

    <form-section title="体脂秤" caption="ScaleBle 独立于指环 bleManager">
      <view class="station-actions">
        <button class="secondary-button" loading="{{scanning}}" bindtap="scanDevice">扫描体脂秤</button>
        <button class="secondary-button" loading="{{connecting}}" bindtap="connectDevice">连接体脂秤</button>
      </view>
      <view class="station-meta">连接状态：{{connected ? '已连接' : '未连接'}}</view>
      <view class="station-meta">测量状态：{{statusText}}</view>
      <view wx:if="{{metrics.length}}" class="metric-list">
        <view wx:for="{{metrics}}" wx:key="name" class="metric-card">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}} {{item.unit}}</text>
        </view>
      </view>
      <button wx:if="{{canConfirm}}" class="primary-button" loading="{{saving}}" bindtap="confirmMeasurement">确认并提交</button>
    </form-section>

    <form-section title="候测队列" caption="服务端是唯一状态来源">
      <view wx:if="{{!queue.length}}" class="empty-inline">暂无候测队列</view>
      <view wx:for="{{queue}}" wx:key="id" class="queue-card">
        <view class="queue-row">
          <view class="queue-main">
            <view class="queue-name">{{item.patientSummary.maskedName}}</view>
            <view class="queue-meta">#{{item.queueNo}} · {{item.status}}</view>
          </view>
          <status-tag text="{{item.status}}" tone="{{item.status === 'COMPLETED' ? 'success' : item.status === 'RESULT_PENDING' ? 'warning' : 'neutral'}}" />
        </view>
      </view>
    </form-section>
  </view>
</view>
