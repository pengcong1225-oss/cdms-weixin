.page {
  min-height: 100vh;
  background: var(--cdms-background);
  padding-bottom: 32rpx;
  color: var(--cdms-text);
}

.loading-panel {
  padding: 24rpx;
}

.station-stack {
  padding: 0 24rpx 24rpx;
}

.station-summary,
.queue-card,
.patient-card,
.metric-card {
  border-radius: var(--cdms-radius-card);
  background: var(--cdms-surface);
  box-shadow: var(--cdms-shadow-card);
}

/* 场次区块上下分区：二维码面板 / 场次信息 / 操作按钮纵向堆叠，
   彻底避免旧横排布局在真机上把文字列挤成竖条、按钮叠压文字的问题。 */
.station-summary {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
}

/* 状态 / 过期时间横排展示，空间不足时安全换行而不是压缩截断 */
.station-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 40rpx;
}

/* 操作按钮独立一行横排：均分宽度、空间不足安全换行；
   margin 归零以对齐 app.wxss 中 primary-button 的顶部间距与原生 button 的自动边距 */
.station-side {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.station-side button {
  flex: 1 1 0;
  min-width: 220rpx;
  margin: 0;
}

.station-title {
  color: var(--cdms-heading);
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.station-meta,
.queue-meta,
.patient-meta {
  color: var(--cdms-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.station-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.patient-card,
.queue-card {
  padding: 24rpx;
}

.patient-name,
.queue-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.queue-card + .queue-card {
  margin-top: 16rpx;
}

.queue-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.metric-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.metric-card {
  padding: 18rpx;
}

.metric-label {
  display: block;
  color: var(--cdms-text-secondary);
  font-size: 24rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-inline {
  color: var(--cdms-muted);
  font-size: 24rpx;
  padding: 10rpx 0;
}

/* 二维码面板：整行独立区块，canvas 居中，提示文字完整显示 */
.qr-panel {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: var(--cdms-primary-soft);
  border-radius: var(--cdms-radius-card);
}

.station-qr {
  display: block;
  width: 240px;
  height: 240px;
  background: var(--cdms-surface);
  border-radius: 16rpx;
}

.qr-hint {
  margin-top: 16rpx;
  color: var(--cdms-text-secondary);
  font-size: 22rpx;
  text-align: center;
}
