<view class="page workspace-page">
  <app-header title="医生工作台" subtitle="优先处理待随访和重点风险患者" showBack="{{false}}" showLogout="{{true}}" bindlogout="logout" />

  <state-panel wx:if="{{error}}" state="error" title="工作台数据不可用" message="{{error}}" actionText="重试" bindaction="retry" />

  <view wx:elif="{{loading}}" class="loading-panel">
    <state-panel state="loading" title="加载中" message="正在读取工作台数据" />
  </view>

  <block wx:else>
    <view class="stats-grid">
      <stat-card wx:for="{{summaryCards}}" wx:key="key" title="{{item.title}}" value="{{item.value}}" caption="{{item.caption}}" tone="{{item.tone}}" />
    </view>

    <view class="section-heading">
      <view>
        <view class="section-title">重点患者</view>
        <view class="section-caption">优先处理待随访和高风险患者</view>
      </view>
      <view class="section-link" data-index="0" bindtap="onEntrySelect">患者管理 ›</view>
    </view>

    <view wx:if="{{todoPatients.length}}" class="todo-list">
      <view wx:for="{{todoPatients}}" wx:key="id" class="todo-card" data-index="{{index}}" bindtap="onTodoPatientSelect">
        <view class="todo-main">
          <view class="todo-name">{{item.name || item.patientName || '未命名患者'}}</view>
          <view class="todo-meta">{{item.gender || '性别未填'}} · {{item.age || '--'}}岁 · 下次随访 {{item.nextVisitText}}</view>
          <view class="todo-tags">
            <status-tag text="{{item.priorityText}}" tone="{{item.riskLevel >= 3 ? 'warning' : 'success'}}" />
            <status-tag text="{{item.statusText}}" tone="{{item.visitStatus == 0 ? 'warning' : 'success'}}" />
          </view>
        </view>
        <button class="todo-action" catchtap="onTodoFollowup" data-index="{{index}}">开始随访</button>
      </view>
    </view>
    <state-panel wx:else state="empty" title="暂无待办患者" message="当前没有待随访患者，可进入患者管理查看全部患者。" actionText="患者管理" data-index="0" bindaction="onEntrySelect" />

    <view class="section-heading compact-heading">
      <view>
        <view class="section-title">工作入口</view>
        <view class="section-caption">按工作任务进入对应模块</view>
      </view>
    </view>
    <view class="action-grid">
      <workspace-card wx:for="{{primaryActions}}" wx:key="key" data-index="{{item.key}}" title="{{item.title}}" subtitle="{{item.subtitle}}" icon="{{item.icon}}" disabled="{{item.disabled}}" bindselect="onEntrySelectByKey" />
    </view>

    <view class="device-section card">
      <view class="device-section-head">
        <view>
          <view class="section-title">设备入口</view>
          <view class="section-caption">设备中心固定保留，不与业务入口重复铺开</view>
        </view>
        <status-tag text="{{deviceSummary.connectionText}}" tone="{{deviceSummary.bound ? 'success' : 'neutral'}}" />
      </view>
      <view class="device-summary" bindtap="openDevice">
        <view class="device-icon">设</view>
        <view class="device-copy">
          <view class="device-name">{{deviceSummary.name}}</view>
          <view class="device-meta">{{deviceSummary.syncText}}</view>
        </view>
        <text class="device-arrow">›</text>
      </view>
      <view class="device-actions">
        <workspace-card wx:for="{{deviceActions}}" wx:key="key" data-index="{{item.key}}" title="{{item.title}}" subtitle="{{item.subtitle}}" icon="{{item.icon}}" disabled="{{item.disabled}}" bindselect="onEntrySelectByKey" />
      </view>
    </view>
  </block>

</view>
