.page{min-height:100vh;background:#f4f8f6;padding-bottom:32rpx;color:#173d32}.hero{padding:36rpx 32rpx 28rpx;background:linear-gradient(135deg,#31966e,#17644c);color:#fff;display:flex;align-items:center;gap:20rpx}.back{font-size:58rpx;line-height:1}.eyebrow{font-size:24rpx;opacity:.8}.title{font-size:42rpx;font-weight:700}.badge{margin-left:auto;background:rgba(255,255,255,.18);border-radius:24rpx;padding:10rpx 16rpx;font-size:22rpx}.notice{margin:20rpx 24rpx;color:#6f867d;font-size:24rpx}.card{margin:20rpx 24rpx;background:#fff;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 26rpx rgba(23,61,50,.06)}.section-title{font-weight:700;font-size:30rpx;margin-bottom:20rpx}.hint{color:#6f867d;font-size:24rpx;line-height:1.6;margin-bottom:16rpx}.picker{border:1rpx solid #dce8e2;border-radius:14rpx;padding:24rpx;color:#527166;display:flex;justify-content:space-between}.profile-card{margin-top:18rpx;background:#f3faf6;border:1rpx solid #d3eadd;border-radius:14rpx;padding:18rpx 20rpx}.profile-title{font-size:24rpx;color:#16805b;font-weight:600;margin-bottom:10rpx}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:8rpx 18rpx;font-size:24rpx;color:#3f5c51;word-break:break-all}.profile-grid text:nth-child(odd){grid-column:1}.profile-grid text:nth-child(even){grid-column:2}.profile-grid text:first-child{grid-column:1 / -1}.outline,.primary,.confirm{margin-top:18rpx;border-radius:14rpx;font-size:28rpx}.outline{color:#16805b;background:#eff9f4;border:1rpx solid #a9ddc4}.primary,.confirm{color:#fff;background:#31966e}.confirm{background:#d88a35}.status{margin-top:16rpx;text-align:center;color:#6f867d;font-size:24rpx}.battery{margin-top:14rpx;text-align:center;color:#6f867d;font-size:24rpx}.partial{margin-top:14rpx;text-align:center;color:#79661d;background:#fff9e2;border-radius:12rpx;padding:12rpx;font-size:24rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.metric{background:#f3faf6;border-radius:14rpx;padding:18rpx;font-size:24rpx}.metric-value{display:block;font-size:30rpx;font-weight:700;margin-top:8rpx}.error{margin:24rpx;color:#c65353;background:#fff0f0;border-radius:14rpx;padding:20rpx;font-size:24rpx}
.search-row { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.search-input { flex: 1; min-width: 0; height: 72rpx; padding: 0 24rpx; border-radius: 16rpx; background: #f4f7f5; box-sizing: border-box; font-size: 26rpx; }
.search-btn { margin: 0; height: 72rpx; line-height: 72rpx; padding: 0 26rpx; border-radius: 16rpx; background: #e5f6ee; color: #0c9b6c; font-size: 24rpx; }
.loadmore { margin-top: 14rpx; text-align: center; color: #0c9b6c; font-size: 24rpx; padding: 10rpx 0; }
