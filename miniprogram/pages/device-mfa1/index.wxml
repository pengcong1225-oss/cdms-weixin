<view class="page mfa1-station-page">
  <app-header
    title="MFA-1 血糖工作站"
    subtitle="场次令牌只用于扫码签到，患者身份由服务端派生"
    showBack="{{true}}"
    bindback="backWorkspace"
  />

  <state-panel wx:if="{{errorText}}" state="error" title="操作失败" message="{{errorText}}" actionText="重试" bindaction="retry" />

  <view wx:elif="{{loading}}" class="loading-panel">
    <state-panel state="loading" title="加载中" message="正在读取 MFA-1 场次" />
  </view>

  <view wx:else class="station-stack">
    <form-section title="场次" caption="二维码仅包含场次和不透明签到令牌，不包含患者信息">
      <view class="station-summary">
        <view wx:if="{{qrPayload}}" class="qr-panel">
          <canvas class="station-qr" canvas-id="mfa1Qr" style="width: 240px; height: 240px;"></canvas>
          <view class="qr-hint">患者使用微信扫一扫加入血糖测量队列</view>
        </view>
        <view class="station-main">
          <view class="station-title">场次 {{stationId || '未创建'}}</view>
          <view class="station-meta">状态：{{stationStatus}}</view>
          <view wx:if="{{tokenExpiresAt}}" class="station-meta">过期：{{tokenExpiresAt}}</view>
        </view>
        <view class="station-side">
          <button class="secondary-button" bindtap="copyToken" wx:if="{{qrPayload}}">复制签到信息</button>
          <button class="primary-button" loading="{{creating}}" bindtap="createStation">创建场次</button>
        </view>
      </view>
      <view class="station-actions">
        <button class="secondary-button" bindtap="callNext">下一位</button>
        <button class="secondary-button" bindtap="skipCurrent">跳过</button>
        <button class="secondary-button" bindtap="requeueCurrent">重排</button>
        <button class="secondary-button" loading="{{saving}}" bindtap="confirmMeasurement">确认并提交</button>
        <button class="secondary-button" bindtap="closeStation">关闭场次</button>
      </view>
    </form-section>

    <form-section title="当前患者" caption="仅展示服务端脱敏摘要">
      <view wx:if="{{currentQueueItem}}" class="patient-card">
        <view class="patient-name">{{currentQueueItem.patientSummary.maskedName}}</view>
        <view class="patient-meta">状态：{{currentQueueItem.status}}</view>
        <view wx:if="{{currentQueueItem.patientSummary.genderText || currentQueueItem.patientSummary.gender}}" class="patient-meta">性别：{{currentQueueItem.patientSummary.genderText || currentQueueItem.patientSummary.gender}}</view>
        <view wx:if="{{currentQueueItem.patientSummary.age}}" class="patient-meta">年龄：{{currentQueueItem.patientSummary.age}}</view>
        <view wx:if="{{currentDraft}}" class="patient-meta">草稿：{{currentDraft.id}} / {{currentDraft.status}}</view>
      </view>
      <view wx:else class="empty-inline">暂无当前患者</view>
    </form-section>

    <form-section title="MFA-1 血糖仪" caption="Mfa1Ble 独立通道，结果帧 0x78 由设备主动推送">
      <view class="station-actions">
        <button class="secondary-button" loading="{{scanning}}" bindtap="scanDevice">扫描 MFA-1</button>
        <button class="secondary-button" loading="{{connecting}}" bindtap="connectDevice">连接并同步时间</button>
      </view>
      <view class="station-meta">连接状态：{{connected ? '已连接' : '未连接'}}</view>
      <view class="station-meta">电量：{{batteryText || '未知'}}</view>
      <view class="station-meta">测量状态：{{statusText}}</view>
      <view wx:if="{{deviceTypeMismatch}}" class="station-meta mismatch-hint">设备类型不匹配：请扫描正确的设备二维码</view>
      <view class="measurement-item-list">
        <view wx:for="{{measurementItems}}" wx:key="key" class="measurement-item {{item.enabled ? '' : 'disabled'}}">
          <text class="metric-label">{{item.label}}</text>
          <text wx:if="{{item.enabled}}" class="measurement-state">可测</text>
          <text wx:else class="measurement-soon">{{item.note}}，操作入口暂不可用</text>
        </view>
      </view>
      <!-- 血糖测量语境（设计 §10.1）：默认 UNKNOWN，医生必须显式选择空腹/餐后/随机才允许提交草稿 -->
      <view class="glucose-context-row">
        <text class="metric-label">血糖测量语境</text>
        <picker mode="selector" range="{{glucoseContextOptions}}" value="{{glucoseContextIndex}}" bindchange="onGlucoseContextChange">
          <text class="glucose-context-value {{glucoseContextConfirmed ? '' : 'pending'}}">{{glucoseContextText}}</text>
        </picker>
        <text wx:if="{{!glucoseContextConfirmed}}" class="measurement-soon">需医生确认</text>
      </view>
      <view wx:if="{{partialLipidText}}" class="partial-lipid-hint">{{partialLipidText}}</view>
      <view wx:if="{{metrics.length}}" class="metric-list">
        <view wx:for="{{metrics}}" wx:key="name" class="metric-card">
          <text class="metric-label">{{item.label}}{{item.state ? '（' + item.state + '）' : ''}}</text>
          <text class="metric-value">{{item.value}} {{item.unit}}{{item.partial ? '（部分血脂结果）' : ''}}</text>
        </view>
      </view>
      <button wx:if="{{canConfirm}}" class="primary-button" loading="{{saving}}" bindtap="confirmMeasurement">确认并提交</button>
    </form-section>

    <form-section title="候测队列" caption="服务端是唯一状态来源">
      <view wx:if="{{!queue.length}}" class="empty-inline">暂无候测队列</view>
      <view wx:for="{{queue}}" wx:key="id" class="queue-card">
        <view class="queue-row">
          <view class="queue-main">
            <view class="queue-name">{{item.patientSummary.maskedName}}</view>
            <view class="queue-meta">#{{item.queueNo}} · {{item.status}}</view>
          </view>
          <status-tag text="{{item.status}}" tone="{{item.status === 'COMPLETED' ? 'success' : item.status === 'RESULT_PENDING' ? 'warning' : 'neutral'}}" />
        </view>
      </view>
    </form-section>
  </view>
</view>
