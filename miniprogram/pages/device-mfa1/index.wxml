<view class="page device-mfa1-page">
  <app-header
    title="MFA-1 会话工作站"
    subtitle="会话与 WSS 令牌仅保存在当前页面内存中"
    showBack="{{true}}"
    bindback="backWorkspace"
  />

  <state-panel wx:if="{{errorText}}" state="error" title="操作失败" message="{{errorText}}" actionText="重试" bindaction="retrySession" />

  <view wx:elif="{{loading || refreshing}}" class="loading-panel">
    <state-panel state="loading" title="加载中" message="正在读取 MFA-1 会话" />
  </view>

  <view wx:else class="workspace-stack">
    <form-section title="会话参数" caption="业务会话、机构和患者由服务端校验">
      <view class="field-grid">
        <view class="field-card">
          <view class="field-label">业务会话 ID</view>
          <input class="field-input" value="{{businessSessionId}}" data-field="businessSessionId" bindinput="updateField" placeholder="mfa1-..." />
        </view>
        <view class="field-card">
          <view class="field-label">机构 ID</view>
          <input class="field-input" value="{{orgId}}" data-field="orgId" bindinput="updateField" placeholder="机构 ID" />
        </view>
        <view class="field-card">
          <view class="field-label">患者编号</view>
          <input class="field-input" value="{{patientRef}}" data-field="patientRef" bindinput="updateField" placeholder="患者编号" />
        </view>
        <view class="field-card">
          <view class="field-label">追踪 ID</view>
          <input class="field-input" value="{{traceId}}" data-field="traceId" bindinput="updateField" placeholder="traceId" />
        </view>
        <view class="field-card">
          <view class="field-label">过期秒数</view>
          <input class="field-input" type="number" value="{{expiresInSeconds}}" data-field="expiresInSeconds" bindinput="updateField" placeholder="600" />
        </view>
      </view>
      <view class="action-row">
        <button class="primary-button" loading="{{creating}}" bindtap="createSession">创建会话</button>
        <button class="secondary-button" loading="{{refreshing}}" bindtap="loadSession">读取会话</button>
        <button class="secondary-button" loading="{{launching}}" bindtap="launchSession">签发 WSS 令牌</button>
        <button class="secondary-button" loading="{{cancelling}}" bindtap="cancelSession">取消会话</button>
      </view>
    </form-section>

    <form-section title="会话状态" caption="仅展示服务端回传信息">
      <view class="status-summary">
        <status-tag text="{{sessionStatus}}" tone="{{sessionTone}}" />
        <view class="status-line">会话 ID：{{sessionId || '未创建'}}</view>
        <view class="status-line">捕获 ID：{{captureId || '-'}}</view>
        <view class="status-line">过期时间：{{sessionExpiresAtText}}</view>
        <view class="status-line">失败码：{{failureCode || '-'}}</view>
        <view class="status-line">失败原因：{{failureMessage || '-'}}</view>
        <view class="status-line">WSS 状态：{{tokenStateText}}</view>
        <view class="status-line">WSS 过期：{{tokenExpiresAtText}}</view>
      </view>
      <view class="action-row">
        <button class="secondary-button" bindtap="retrySession">重试会话</button>
      </view>
    </form-section>
  </view>
</view>
