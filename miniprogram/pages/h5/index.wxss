/* H5 业务工作台承载页。现代基础库下 web-view 同层渲染，原生浮层可覆盖其上；
   若旧基础库浮层不显示，可将 .h5-device-fab 换成 cover-view 实现。 */
.h5-device-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  z-index: 999;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  background: #0c9b6c;
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(12, 155, 108, 0.35);
}

.h5-device-fab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 24rpx;
  font-weight: 700;
}

.h5-device-fab-text {
  font-size: 25rpx;
  font-weight: 650;
  line-height: 44rpx;
}
