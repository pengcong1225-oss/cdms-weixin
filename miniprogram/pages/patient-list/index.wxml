<view class="page patient-list-page">
  <app-header title="患者管理" subtitle="{{subtitle}}" showBack="{{true}}" bindback="backWorkspace" />

  <view wx:if="{{selectionMode}}" class="selection-hint card">选择患者后将继续进入对应工作内容</view>

  <scroll-view class="filter-scroll" scroll-x="true" show-scrollbar="false">
    <view class="filter-row">
      <view wx:for="{{quickFilters}}" wx:key="value" class="filter-chip {{item.value == currentFilter ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onQuickFilter">{{item.label}}</view>
      <view class="filter-chip filter-chip-more {{showAdvancedFilter ? 'active' : ''}}" bindtap="toggleAdvancedFilter">筛选</view>
    </view>
  </scroll-view>

  <view wx:if="{{showAdvancedFilter}}" class="advanced-filter card">
    <form-section title="高级筛选" caption="筛选条件由服务端执行">
      <view class="filter-label">风险等级</view>
      <choice-tile options="{{riskOptions}}" value="{{riskLevels}}" multiple="{{true}}" data-field="riskLevels" bindchange="onAdvancedFilterChange" />
      <view class="filter-label">随访状态</view>
      <choice-tile options="{{visitStatusOptions}}" value="{{visitStatus}}" data-field="visitStatus" bindchange="onAdvancedFilterChange" />
      <view class="advanced-actions">
        <button class="secondary-button" bindtap="resetFilters">重置</button>
        <button class="primary-button" bindtap="onApplyFilter">确定</button>
      </view>
    </form-section>
  </view>

  <view class="search-card card">
    <input class="search-input" value="{{keyword}}" placeholder="搜索患者姓名、手机号或证件号" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <button class="search-button" bindtap="onSearch">搜索</button>
  </view>

  <button class="primary-button create-button" bindtap="createPatient">新增档案</button>

  <state-panel wx:if="{{error}}" state="error" title="加载失败" message="{{error}}" actionText="重试" bindaction="retry" />
  <state-panel wx:elif="{{empty}}" state="empty" title="暂无患者" message="当前服务端范围内没有匹配患者。" actionText="新增档案" bindaction="createPatient" />

  <view wx:else class="patient-stack">
    <patient-card wx:for="{{patients}}" wx:key="id" data-id="{{item.id}}" patient="{{item}}" masked="{{true}}" bindselect="onPatientSelect" />
    <view wx:if="{{loading}}" class="list-hint">加载中...</view>
    <view wx:elif="{{!hasMore}}" class="list-hint">已显示全部</view>
  </view>
</view>
