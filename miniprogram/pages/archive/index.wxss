.error-box { margin: 120rpx 44rpx; padding: 40rpx 32rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(41, 92, 67, .08); }
.error-title { color: #b0463a; font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; }
.error-text { color: #71877c; font-size: 25rpx; line-height: 1.7; }
