<view class="page checkin-page">
  <app-header title="扫码签到" subtitle="兼容医生工作站与机构通用签到码" showBack="{{true}}" bindback="goBack" />
  <state-panel wx:if="{{errorText}}" state="error" title="签到失败" message="{{errorText}}" actionText="重新扫码" bindaction="scanAgain" />

  <view wx:if="{{checkedIn && checkinKind === 'STATION'}}" class="success-card card">
    <view class="success-icon">✓</view>
    <view class="success-title">已加入测量队列</view>
    <view class="success-text">请在现场等待医生叫号，医生确认后测量结果会写入你的健康档案。</view>
    <view wx:if="{{queueNo}}" class="queue-number">排队号 {{queueNo}}</view>
    <button class="primary-button" bindtap="scanAgain">扫描其他场次</button>
  </view>

  <view wx:elif="{{checkedIn}}" class="success-card card">
    <view class="success-icon">✓</view>
    <view class="success-title">签到成功</view>
    <view class="success-text">本次通用签到已完成，记录已提交至健康档案。</view>
    <view wx:if="{{checkinDateText}}" class="queue-number">{{checkinDateText}}</view>
    <view class="status-text">{{statusText}}</view>
    <button class="primary-button" bindtap="scanAgain">继续签到</button>
  </view>

  <view wx:else class="checkin-card card">
    <view class="scan-illustration">扫</view>
    <view class="checkin-title">扫描签到二维码</view>
    <view class="checkin-text">可扫描医生工作站二维码或机构通用签到码，签到后无需填写患者信息。</view>
    <button class="primary-button" loading="{{scanning || submitting}}" bindtap="scanCode">打开相机扫码</button>
    <view class="status-text">{{statusText}}</view>
  </view>
</view>
