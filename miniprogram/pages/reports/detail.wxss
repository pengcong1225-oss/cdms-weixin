page {
  background: var(--cdms-background);
}

.reports-detail-page {
  padding-bottom: 72rpx;
}

.detail-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-row {
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  align-items: flex-start;
}

.report-main {
  flex: 1;
  min-width: 0;
}

.report-no,
.ai-meta {
  color: var(--cdms-text);
  font-size: 24rpx;
  line-height: 36rpx;
}

.report-meta {
  margin: 8rpx 0;
  color: var(--cdms-muted);
  font-size: 22rpx;
}

.report-actions,
.action-stack {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.markdown {
  margin-top: 16rpx;
  color: var(--cdms-text);
  font-size: 24rpx;
  line-height: 36rpx;
  white-space: pre-wrap;
}

.confirm-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--cdms-text);
  font-size: 24rpx;
}

