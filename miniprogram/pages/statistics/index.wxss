page {
  background: var(--cdms-background);
}

.stats-page {
  padding-bottom: 56rpx;
}

.range-bar {
  margin-bottom: 18rpx;
}

.stats-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.trend-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
}

.trend-row + .trend-row {
  border-top: 1rpx solid rgba(13, 82, 57, 0.08);
}

.trend-copy {
  min-width: 0;
}

.trend-label {
  color: var(--cdms-text);
  font-size: 25rpx;
  font-weight: 700;
}

.trend-caption {
  margin-top: 6rpx;
  color: var(--cdms-muted);
  font-size: 21rpx;
  line-height: 30rpx;
}

.trend-value {
  flex: none;
  color: var(--cdms-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.empty-inline {
  padding: 10rpx 0;
  color: var(--cdms-muted);
  font-size: 22rpx;
}
