<view class="page message-page">
  <app-header title="消息中心" subtitle="打开消息后会刷新服务端已读状态，不在本地伪造通知" showBack="{{true}}" bindback="backWorkspace" />

  <view class="stats-grid">
    <stat-card title="未读" value="{{unreadCount}}" caption="来自服务端" tone="warning" />
    <stat-card title="总数" value="{{total}}" caption="当前页统计" tone="neutral" />
  </view>

  <view class="toolbar">
    <button class="secondary-button toolbar-button" loading="{{markingAll}}" disabled="{{markingAll}}" bindtap="markAllRead">全部已读</button>
  </view>

  <state-panel wx:if="{{error}}" state="error" title="加载失败" message="{{error}}" actionText="重试" bindaction="retry" />
  <state-panel wx:elif="{{empty}}" state="empty" title="暂无消息" message="当前没有来自服务端的消息。" />

  <view wx:else class="message-stack">
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="message-card card"
      data-id="{{item.id}}"
      data-reading="{{readingId === item.id}}"
      bindtap="onMessageTap"
    >
      <view class="message-top">
        <view class="message-title">{{item.title}}</view>
        <status-tag text="{{item.readText}}" tone="{{item.readTone}}" />
      </view>
      <view class="message-content">{{item.content}}</view>
      <view class="message-meta">{{item.timeText}}</view>
    </view>

    <view wx:if="{{loading}}" class="list-hint">加载中...</view>
    <view wx:elif="{{!hasMore}}" class="list-hint">已显示全部</view>
  </view>
</view>
